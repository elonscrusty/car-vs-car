--!strict
local Harness = require("./harness")
local Rematch = require("../src/shared/Rematch")

local test, eq = Harness.test, Harness.eq

print("Rematch")

test("taps before the window opens do not count", function()
	local s = Rematch.new({ "a" })
	eq(Rematch.tap(s, "a"), false)
	eq(Rematch.decide(s), "lobby")
end)

test("lone player: tap starts a rematch", function()
	local s = Rematch.new({ "a" })
	Rematch.openWindow(s)
	eq(Rematch.decide(s), "wait")
	eq(Rematch.tap(s, "a"), true)
	eq(Rematch.tap(s, "a"), false)
	Rematch.closeWindow(s)
	eq(Rematch.decide(s), "start")
end)

test("two humans: both must tap", function()
	local s = Rematch.new({ "a", "b" })
	Rematch.openWindow(s)
	Rematch.tap(s, "a")
	eq(Rematch.decide(s), "wait")
	Rematch.closeWindow(s)
	eq(Rematch.decide(s), "lobby")
	local t = Rematch.new({ "a", "b" })
	Rematch.openWindow(t)
	Rematch.tap(t, "a")
	Rematch.tap(t, "b")
	Rematch.closeWindow(t)
	eq(Rematch.decide(t), "start")
end)

test("strangers and late taps are ignored", function()
	local s = Rematch.new({ "a" })
	Rematch.openWindow(s)
	eq(Rematch.tap(s, "zzz"), false)
	Rematch.closeWindow(s)
	eq(Rematch.tap(s, "a"), false)
	eq(Rematch.decide(s), "lobby")
end)

test("a player leaving cancels the rematch", function()
	local s = Rematch.new({ "a", "b" })
	Rematch.openWindow(s)
	Rematch.tap(s, "a")
	Rematch.tap(s, "b")
	Rematch.playerLeft(s, "b")
	Rematch.closeWindow(s)
	eq(Rematch.decide(s), "lobby")
	eq(Rematch.tap(s, "a"), false)
end)

test("empty player list never starts", function()
	local s = Rematch.new({})
	Rematch.closeWindow(s)
	eq(Rematch.decide(s), "lobby")
end)

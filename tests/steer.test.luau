--!strict
local Harness = require("./harness")
local Ai = require("../src/shared/Ai")
local Steer = require("../src/shared/Steer")

local test, eq, near = Harness.test, Harness.eq, Harness.near

print("Steer")

test("sanitize clamps and rejects junk", function()
	eq(Steer.sanitize(0.5), 0.5)
	eq(Steer.sanitize(7), 1)
	eq(Steer.sanitize(-7), -1)
	eq(Steer.sanitize("1"), 0)
	eq(Steer.sanitize(nil), 0)
	eq(Steer.sanitize({}), 0)
	eq(Steer.sanitize(0 / 0), 0)
	eq(Steer.sanitize(math.huge), 0)
	eq(Steer.sanitize(-math.huge), 0)
end)

test("steering right spins negative (clockwise from above)", function()
	near(Steer.spin(1, 3, 1), -3)
	near(Steer.spin(-1, 3, 1), 3)
	near(Steer.spin(0.5, 4, 0.5), -1)
	eq(Steer.spin(0, 3, 1) == 0, true)
end)

test("spin sign matches the autopilot convention", function()
	-- Car facing -Z, target on its right (+X): signedAngle is negative, so is the spin.
	local rightAngle = Ai.signedAngle(0, -1, 1, 0)
	eq(rightAngle < 0, true)
	eq(Steer.spin(1, 3, 1) < 0, rightAngle < 0)
	local leftAngle = Ai.signedAngle(0, -1, -1, 0)
	eq(Steer.spin(-1, 3, 1) > 0, leftAngle > 0)
end)

test("smooth eases without overshoot", function()
	near(Steer.smooth(0, 1, 0.05, 10), 0.5)
	near(Steer.smooth(0, 1, 1, 10), 1)
	near(Steer.smooth(1, -1, 0.1, 10), 0)
	near(Steer.smooth(0.2, 0.2, 0.1, 10), 0.2)
end)

test("stale input counts as 0", function()
	local s = Steer.newState()
	eq(Steer.current(s, 0, 0.5), 0)
	Steer.set(s, 1, 10)
	eq(Steer.current(s, 10.2, 0.5), 1)
	eq(Steer.current(s, 10.5, 0.5), 1)
	eq(Steer.current(s, 10.6, 0.5), 0)
	Steer.set(s, -0.4, 10.6) -- a refresh revives it
	near(Steer.current(s, 10.7, 0.5), -0.4)
end)

test("set sanitizes and reset clears", function()
	local s = Steer.newState()
	Steer.set(s, 99, 1)
	eq(s.value, 1)
	Steer.set(s, "x", 1)
	eq(s.value, 0)
	Steer.set(s, 1, 1)
	Steer.reset(s)
	eq(Steer.current(s, 1, 0.5), 0)
end)

test("gas: a client with no gas value keeps it fully on, and stale gas coasts", function()
	local s = Steer.newState()
	Steer.set(s, 0, 10)
	eq(Steer.currentThrottle(s, 10.1, 0.5), 1)
	Steer.set(s, 0, 10, -1)
	eq(Steer.currentThrottle(s, 10.1, 0.5), -1)
	Steer.set(s, 0, 10, 7)
	eq(Steer.currentThrottle(s, 10.1, 0.5), 1)
	Steer.set(s, 0, 10, "x")
	eq(Steer.currentThrottle(s, 10.1, 0.5), 0)
	eq(Steer.currentThrottle(s, 11, 0.5), 0)
	Steer.reset(s)
	eq(s.throttle, 0)
end)

test("screen-relative stick: points where the car should go on screen", function()
	-- camera looks along -Z (right of screen = +X); car faces -Z (same way)
	local s, g = Steer.toward(0, 1, 0, -1, 0, -1, 0.7)
	near(s, 0)
	near(g, 1)
	-- stick right: want +X, car nose -Z, so turn right (steer +)
	s, g = Steer.toward(1, 0, 0, -1, 0, -1, 0.7)
	eq(s, 1)
	near(g, 0.35)
	-- stick left: steer -
	s = Steer.toward(-1, 0, 0, -1, 0, -1, 0.7)
	eq(s, -1)
	-- car already faces +X, stick right: straight on, full gas
	s, g = Steer.toward(1, 0, 0, -1, 1, 0, 0.7)
	near(s, 0)
	near(g, 1)
	-- camera turned (looks +X): stick up means +X
	s, g = Steer.toward(0, 1, 1, 0, 1, 0, 0.7)
	near(s, 0)
	-- released stick: nothing
	s, g = Steer.toward(0, 0, 0, -1, 0, -1, 0.7)
	eq(s, 0)
	eq(g, 0)
	-- stick behind the car: turns, creeps forward
	s, g = Steer.toward(0, -1, 0, -1, 0, -1, 0.7)
	near(math.abs(s), 1)
	near(g, 0.35)
end)

test("screen-relative stick: straight-behind U-turn keeps its turn direction", function()
	-- wanted way is straight behind; tiny sideways wobble must not flip the turn
	local s1 = Steer.toward(0.02, -1, 0, -1, 0, -1, 0.7, 1)
	local s2 = Steer.toward(-0.02, -1, 0, -1, 0, -1, 0.7, 1)
	eq(s1, 1)
	eq(s2, 1)
	local s3 = Steer.toward(0.02, -1, 0, -1, 0, -1, 0.7, -1)
	eq(s3, -1)
end)

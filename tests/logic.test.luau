--!strict
local Harness = require("./harness")
local Logic = require("../src/shared/Logic")

local test, eq, near, truthy = Harness.test, Harness.eq, Harness.near, Harness.truthy

print("Logic")

test("isFinite rejects junk", function()
	eq(Logic.isFinite(5), true)
	eq(Logic.isFinite(0 / 0), false)
	eq(Logic.isFinite(math.huge), false)
	eq(Logic.isFinite("5"), false)
	eq(Logic.isFinite(nil), false)
end)

test("sanitizeLaunch clamps angle and power", function()
	local a, p = Logic.sanitizeLaunch(500, 9, 40)
	eq(a, 40)
	eq(p, 1)
	a, p = Logic.sanitizeLaunch(-500, -3, 40)
	eq(a, -40)
	eq(p, 0)
end)

test("sanitizeLaunch rejects non numbers", function()
	eq(Logic.sanitizeLaunch("x", 0.5, 40), nil)
	eq(Logic.sanitizeLaunch(1, nil, 40), nil)
	eq(Logic.sanitizeLaunch(0 / 0, 0.5, 40), nil)
	eq(Logic.sanitizeLaunch(1, math.huge, 40), nil)
	eq(Logic.sanitizeLaunch({}, {}, 40), nil)
end)

test("launchSpeed maps power to speed", function()
	near(Logic.launchSpeed(0, 60, 140), 60)
	near(Logic.launchSpeed(1, 60, 140), 140)
	near(Logic.launchSpeed(0.5, 60, 140), 100)
	near(Logic.launchSpeed(5, 60, 140), 140)
end)

test("powerAt goes up then down", function()
	near(Logic.powerAt(0, 2), 0)
	near(Logic.powerAt(0.5, 2), 0.5)
	near(Logic.powerAt(1, 2), 1)
	near(Logic.powerAt(1.5, 2), 0.5)
	near(Logic.powerAt(2, 2), 0)
	near(Logic.powerAt(3, 2), 1)
end)

test("impactDamage ignores slow bumps", function()
	eq(Logic.impactDamage(5, 1, 0.5, 12), 0)
	near(Logic.impactDamage(80, 2, 0.5, 12), 80)
end)

test("applyDamage never below 0 and flags death", function()
	local hp, dead = Logic.applyDamage(100, 30)
	near(hp, 70)
	eq(dead, false)
	hp, dead = Logic.applyDamage(10, 30)
	eq(hp, 0)
	eq(dead, true)
end)

test("canHit respects cooldown", function()
	eq(Logic.canHit(10, 9.8, 0.5), false)
	eq(Logic.canHit(10, 9.4, 0.5), true)
	eq(Logic.canHit(0, -math.huge, 0.5), true)
end)

test("attackerIndex picks faster car, tie goes to 1", function()
	eq(Logic.attackerIndex(30, 10), 1)
	eq(Logic.attackerIndex(10, 30), 2)
	eq(Logic.attackerIndex(20, 20), 1)
end)

test("flip timer: upside down 1s -> flip once, right side up resets", function()
	local t, flip = Logic.updateFlipTimer(0, -1, 0.5, 0.2, 1)
	eq(flip, false)
	t, flip = Logic.updateFlipTimer(t, -1, 0.4, 0.2, 1)
	eq(flip, false)
	t, flip = Logic.updateFlipTimer(t, -1, 0.2, 0.2, 1)
	eq(flip, true)
	eq(t, 0)
	t, flip = Logic.updateFlipTimer(0.9, 1, 0.1, 0.2, 1)
	eq(t, 0)
	eq(flip, false)
end)

test("hitStrength scales to 1 and clamps", function()
	eq(Logic.hitStrength(0, 70), 0)
	eq(Logic.hitStrength(35, 70), 0.5)
	eq(Logic.hitStrength(200, 70), 1)
end)

test("hitStopTime: weak = none, strong = longest", function()
	eq(Logic.hitStopTime(0.3, 0.04, 0.12, 0.4), 0)
	near(Logic.hitStopTime(0.4, 0.04, 0.12, 0.4), 0.04)
	near(Logic.hitStopTime(1, 0.04, 0.12, 0.4), 0.12)
	truthy(Logic.hitStopTime(0.7, 0.04, 0.12, 0.4) > 0.04)
end)

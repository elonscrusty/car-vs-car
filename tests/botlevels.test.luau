--!strict
local H = require("./harness")
local BotLevels = require("../src/shared/BotLevels")
local Inventory = require("../src/shared/Inventory")

print("BotLevels")

H.test("get falls back to medium for anything unknown", function()
	H.eq(BotLevels.get("easy").name, "easy")
	H.eq(BotLevels.get("hard").name, "hard")
	H.eq(BotLevels.get(nil).name, "medium")
	H.eq(BotLevels.get(5).name, "medium")
	H.eq(BotLevels.get("insane").name, "medium")
	H.truthy(not BotLevels.isValid("insane"))
	H.truthy(BotLevels.isValid("easy"))
end)

H.test("levels get harder: noise down, speed up", function()
	local e, m, h = BotLevels.get("easy"), BotLevels.get("medium"), BotLevels.get("hard")
	H.eq(e.noiseDeg, 28)
	H.eq(m.noiseDeg, 10)
	H.eq(h.noiseDeg, 3)
	H.eq(e.speedMult, 0.8)
	H.eq(m.speedMult, 1)
	H.eq(h.speedMult, 1.1)
	H.truthy(e.turnGainMult < m.turnGainMult and m.turnGainMult < h.turnGainMult)
	H.truthy(h.runUpMult > m.runUpMult)
end)

H.test("next cycles easy -> medium -> hard -> easy", function()
	H.eq(BotLevels.next("easy"), "medium")
	H.eq(BotLevels.next("medium"), "hard")
	H.eq(BotLevels.next("hard"), "easy")
	H.eq(BotLevels.next("junk"), "hard")
end)

H.test("reward multiplier and launch power", function()
	H.eq(BotLevels.rewardMultiplier("easy"), 0.8)
	H.eq(BotLevels.rewardMultiplier("hard"), 1.3)
	H.eq(BotLevels.rewardMultiplier(nil), 1)
	local h = BotLevels.get("hard")
	H.eq(BotLevels.launchPower(h, 0), h.powerMin)
	H.eq(BotLevels.launchPower(h, 1), h.powerMax)
	H.eq(BotLevels.launchPower(h, 7), h.powerMax)
end)

H.test("only easy wanders, and the kick fades", function()
	local m = BotLevels.get("medium")
	H.eq(BotLevels.wanderOffsetDeg(m, 1.2, 1), 0)
	local e = BotLevels.get("easy")
	local peak = math.abs(BotLevels.wanderOffsetDeg(e, 3.0, 1))
	H.truthy(peak > 0 and peak <= e.wanderDeg)
	H.truthy(math.abs(BotLevels.wanderOffsetDeg(e, 3.0 + e.wanderFade * 0.5, 1)) < peak)
	H.eq(BotLevels.wanderOffsetDeg(e, 3.0 + e.wanderFade + 0.01, 1), 0)
end)

H.test("stuckLimit: hard backs off sooner than easy", function()
	local e, h = BotLevels.get("easy"), BotLevels.get("hard")
	H.truthy(BotLevels.stuckLimit(h, 1) < BotLevels.stuckLimit(e, 1))
	H.eq(BotLevels.stuckLimit(BotLevels.get("medium"), 1.5), 1.5)
end)

H.test("profile botLevel defaults to medium and migrates", function()
	H.eq(Inventory.default().botLevel, "medium")
	H.eq(Inventory.migrate({}).botLevel, "medium")
	H.eq(Inventory.migrate({ botLevel = "hard" }).botLevel, "hard")
	H.eq(Inventory.migrate({ botLevel = "nope" }).botLevel, "medium")
	H.eq(Inventory.migrate({ botLevel = 3 }).botLevel, "medium")
end)

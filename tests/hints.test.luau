--!strict
local H = require("./harness")
local Hints = require("../src/shared/Hints")
local Inventory = require("../src/shared/Inventory")

print("Hints")

H.test("three hints in order, each with text", function()
	H.eq(#Hints.Order, 3)
	H.eq(Hints.Order[1], "pad")
	H.eq(Hints.Order[2], "aim")
	H.eq(Hints.Order[3], "claw")
	for _, id in Hints.Order do
		H.truthy(#Hints.text(id) > 0)
	end
	H.eq(Hints.text("nope"), "")
	H.eq(Hints.target("pad"), "pad")
	H.eq(Hints.target("claw"), "claw")
	H.eq(Hints.target("aim"), nil)
end)

H.test("shouldShow until marked seen, markSeen reports change once", function()
	local seen: Hints.Seen = {}
	H.truthy(Hints.shouldShow(seen, "pad"))
	H.truthy(Hints.markSeen(seen, "pad"))
	H.eq(Hints.shouldShow(seen, "pad"), false)
	H.eq(Hints.markSeen(seen, "pad"), false)
	H.truthy(Hints.shouldShow(seen, "aim"))
end)

H.test("unknown ids are rejected", function()
	local seen: Hints.Seen = {}
	H.eq(Hints.isKnown("hax"), false)
	H.eq(Hints.isKnown(5), false)
	H.eq(Hints.markSeen(seen, "hax"), false)
	H.eq(Hints.markSeen(seen, {}), false)
	H.eq(next(seen), nil)
	H.eq(Hints.shouldShow(seen, "hax"), false)
end)

H.test("clean keeps only known true flags", function()
	local out = Hints.clean({ pad = true, aim = "yes", claw = false, junk = true })
	H.truthy(out.pad)
	H.eq(out.aim, nil)
	H.eq(out.claw, nil)
	H.eq(out.junk, nil)
	H.eq(next(Hints.clean("x")), nil)
	H.eq(next(Hints.clean(nil)), nil)
	local list = Hints.seenList({ claw = true, pad = true })
	H.eq(#list, 2)
	H.eq(list[1], "pad")
	H.eq(list[2], "claw")
end)

H.test("profile defaults and migrates hintsSeen (old saves lack it)", function()
	H.eq(next(Inventory.default().hintsSeen), nil)
	local old = Inventory.migrate({ coins = 5, wins = 1, owned = { Heavy = true } })
	H.eq(type(old.hintsSeen), "table")
	H.eq(next(old.hintsSeen), nil)
	H.eq(old.coins, 5)
	local kept = Inventory.migrate({ hintsSeen = { pad = true, aim = 1, zzz = true } })
	H.truthy(kept.hintsSeen.pad)
	H.eq(kept.hintsSeen.aim, nil)
	H.eq(kept.hintsSeen.zzz, nil)
	H.eq(type(Inventory.migrate({ hintsSeen = "x" }).hintsSeen), "table")
	-- survives a save/load round trip
	local p = Inventory.default()
	Hints.markSeen(p.hintsSeen, "claw")
	H.truthy(Inventory.migrate(p).hintsSeen.claw)
end)

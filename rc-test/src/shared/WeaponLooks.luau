-- which look each weapon wears when nothing else is chosen (a weapon skin later swaps this)
WeaponLooks.DEFAULT = { Gun = "gatling" } :: { [string]: string }

function WeaponLooks.get(id: any): Look?
	return if type(id) == "string" then WeaponLooks.LOOKS[id] else nil
end

-- the look a weapon wears: `skin` (a look id) if it is one, else the weapon's default
function WeaponLooks.forWeapon(weapon: any, skin: any): Look?
	local chosen = WeaponLooks.get(skin)
	if chosen then
		return chosen
	end
	if type(weapon) ~= "string" then
		return nil
	end
	return WeaponLooks.get(WeaponLooks.DEFAULT[weapon])
end

return WeaponLooks

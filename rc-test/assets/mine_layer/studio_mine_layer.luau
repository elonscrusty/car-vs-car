-- part name -> colour key in the car's table, material, reflectance
local MATS: { [string]: { any } } = {
	Body = { "Body", BODY },
	Accent = { "Accent", PLASTIC },
	Glass = { "Glass", GLASS },
	Chrome = { "Chrome", CHROME },
	Steel = { "Steel", STEEL },
	Dark = { "Dark", PLASTIC },
	Trim = { "Trim", PLASTIC },
	Plate = { "Plate", PLASTIC },
	Headlights = { "Headlights", NEON },
	Glow = { "Glow", NEON },
	Taillights = { "Taillights", NEON },
	Mine = { "Mine", PLASTIC },
	Spike = { "Spike", STEEL },
	Blink = { "Blink", NEON },
	ArmHinge = { "Chrome", CHROME },
	ArmSteel = { "Steel", STEEL },
	ArmAccent = { "Accent", PLASTIC },
	ArmTrim = { "Trim", PLASTIC },
	LoadedMine = { "Mine", PLASTIC },
	LoadedSpike = { "Spike", STEEL },
	LoadedChrome = { "Chrome", CHROME },
	LoadedBlink = { "Blink", NEON },
}

local function lookOf(name: string): { any }?
	if MATS[name] then
		return MATS[name]
	elseif string.sub(name, 1, 5) == "Wheel" then
		return { "Tyre", PLASTIC }
	elseif string.sub(name, 1, 8) == "RimChrome" then
		return MATS.Chrome
	elseif string.sub(name, 1, 7) == "RimDark" then
		return MATS.Dark
	elseif string.sub(name, 1, 3) == "Rim" then
		return MATS.Accent
	end
	return nil
end

local RS = game:GetService("ReplicatedStorage")
local skins = RS:FindFirstChild("CarSkins")
if not skins then
	skins = Instance.new("Folder")
	skins.Name = "CarSkins"
	skins.Parent = RS
end

local function make(car: Car)
	-- the imported meshes, wherever the importer put them (the name may be on the part or on its node)
	local found: { [string]: BasePart } = {}
	local imports: { Instance } = {}
	for _, top in workspace:GetChildren() do
		local all = top:GetDescendants()
		table.insert(all, top)
		local hit = false
		for _, d in all do
			local base = string.match((d.Name:gsub("%.%d+$", "")), "^" .. car.prefix .. "__(.+)$")
			if base then
				hit = true
				local part: BasePart? = if d:IsA("BasePart")
					then d
					else d:FindFirstChildWhichIsA("BasePart", true)
				if part then
					if found[base] and found[base] ~= part then
						warn(base, "imported twice, left one in", part:GetFullName())
					else
						found[base] = part
					end
				end
			end
		end
		if hit then
			table.insert(imports, top)
		end
	end
	if next(found) == nil then
		print(car.name, "- no imported parts found, skipped")
		return
	end

	local model = Instance.new("Model")
	model.Name = car.id
	local count = 0
	for name, part in found do
		local look = lookOf(name)
		part.Name = name
		part.Parent = model
		part.Anchored = true
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		part.Massless = true
		for _, c in part:GetChildren() do
			if c:IsA("SurfaceAppearance") or c:IsA("Texture") or c:IsA("Decal") then
				c:Destroy() -- (the importer's own look would hide the paint)
			end
		end
		if part:IsA("MeshPart") then
			part.TextureID = ""
		end
		if look then
			part.Color = car.colors[look[1]]
			part.Material = look[2][1]
			part.Reflectance = look[2][2]
		else
			warn("no look for part", name)
		end
		count += 1
	end

	local missing = {}
	for _, need in { "Body", "WheelFL", "WheelFR", "WheelRL", "WheelRR", "Headlights" } do
		if not model:FindFirstChild(need) then
			table.insert(missing, need)
		end
	end
	if #missing > 0 then
		warn(car.name, "is missing:", table.concat(missing, ", "), "- import the .obj files again")
		model:Destroy()
		return
	end

	local body = model:FindFirstChild("Body") :: BasePart
	local centre = body.Position
	-- nose at +Z: if the importer turned it round, turn the whole car back
	if (model.Headlights :: BasePart).Position.Z < centre.Z then
		for _, p in model:GetChildren() do
			if p:IsA("BasePart") then
				p.CFrame = CFrame.new(centre)
					* CFrame.Angles(0, math.pi, 0)
					* (CFrame.new(-centre) * p.CFrame)
			end
		end
		print(car.name, "turned round (its nose was at -Z)")
	end
	-- left at +X: if the importer mirrored it, swap the left and right names
	if (model.WheelFL :: BasePart).Position.X < centre.X then
		for _, p in model:GetChildren() do
			local pre, side = string.match(p.Name, "^(.-)([FR][LR])$")
			if pre and (pre == "Wheel" or string.sub(pre, 1, 3) == "Rim") then
				local swapped = (if string.sub(side, 2, 2) == "L" then "R" else "L")
				p.Name = pre .. string.sub(side, 1, 1) .. swapped
			end
		end
		print(car.name, "swapped left and right (the importer mirrored X)")
	end

	model.PrimaryPart = body
	model:SetAttribute("Kart", true)
	model:SetAttribute("Extras", true)
	model:SetAttribute("MaxTurn", MAX_TURN)
	if MAIN and MAIN ~= car.id then
		model:SetAttribute("SkinOf", MAIN)
	end

	local old = skins:FindFirstChild(car.id)
	if old then
		old:Destroy()
	end
	model.Parent = skins
	-- the importer's empty wrappers go (never one that still holds a part)
	for _, top in imports do
		if top.Parent and not top:IsDescendantOf(model) then
			local holdsPart = top:IsA("BasePart")
			for _, d in top:GetDescendants() do
				holdsPart = holdsPart or d:IsA("BasePart")
			end
			if not holdsPart then
				top:Destroy()
			end
		end
	end
	print("CarSkins." .. car.id, "made with", count, "parts")
end

for _, car in CARS do
	make(car)
end
print("Done. Save the place (Ctrl+S).")
